    }

    .pub-stats {
        padding: 12px 16px;
        border-top: 1px solid #f0f0f0;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: #999;
    }

    .pub-actions {
        padding: 8px;
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #f0f0f0;
    }

    .action-button {
        flex: 1;
        padding: 10px;
        border: none;
        background: none;
        cursor: pointer;
        color: #999;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .action-button:hover {
