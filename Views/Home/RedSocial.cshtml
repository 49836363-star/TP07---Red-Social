        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-logout:hover {
        background: #da190b;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(244, 67, 54, 0.4);
    }

    .feed-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .publication-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        animation: slideIn 0.5s ease;
    }

    .pub-header {
        padding: 16px;
        border-bottom: 1px solid #f0f0f0;
    }

    .pub-user-info {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .user-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
    }

    .user-details {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .user-details strong {
        color: #333;
        font-size: 15px;
    }

    .user-details small {
        color: #999;
        font-size: 12px;
    }

    .pub-date {
        font-size: 11px !important;
    }

    .pub-image {
