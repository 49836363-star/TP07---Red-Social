@model List<TP07.Models.Publicacion>
@{
    ViewData["Title"] = "Red Social";
}

<div class="social-feed-container">
    <!-- Header -->
    <div class="social-header">
        <div class="header-content">
            <h1>📱 Red Social</h1>
            <div class="header-actions">
                <span class="user-greeting">Bienvenido, @ViewBag.nombreUsuario</span>
                <a href="@Url.Action("CrearPublicacion", "Home")" class="btn-create">➕ Nueva Publicación</a>
                <a href="@Url.Action("Logout", "Home")" class="btn-logout">🚪 Cerrar Sesión</a>
            </div>
        </div>
    </div>

    <!-- Feed de Publicaciones -->
    <div class="feed-container">
        @if (Model == null || Model.Count == 0)
        {
            <div class="no-publications">
                <p>No hay publicaciones aún. ¡Sé el primero en publicar!</p>
            </div>
        }
        else
        {
            @foreach (var pub in Model)
            {
                var usuario = BD.ObtenerUsuarioPorId(pub.IdUsuario);
                var comentarios = BD.ObtenerComentarios(pub.Id);
                var cantidadLikes = BD.ObtenerCantidadLikes(pub.Id);
                var usuarioActual = ViewBag.usuarioActual as TP07.Models.Usuario;
                var yaLike = usuarioActual != null ? BD.VerificarLike(pub.Id, usuarioActual.Id) : false;

                <div class="publication-card">
                    <!-- Header de la Publicación -->
                    <div class="pub-header">
                        <div class="pub-user-info">
                            <div class="user-avatar">@usuario.nombreUsuario[0].ToString().ToUpper()</div>
                            <div class="user-details">
                                <strong>@usuario.nombre @usuario.apellido</strong>
                                <small>@@@ @usuario.nombreUsuario</small>
                                <small class="pub-date">@DateTime.Parse(pub.fechaPublicacion).ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                    </div>

                    <!-- Imagen -->
                    @if (!string.IsNullOrEmpty(pub.imagen))
                    {
                        <div class="pub-image">
                            <img src="@pub.imagen" alt="@pub.titulo" />
                        </div>
                    }

                    <!-- Contenido -->
                    <div class="pub-content">
                        <h3>@pub.titulo</h3>
                        <p>@pub.descripcion</p>
                    </div>

                    <!-- Stats -->
                    <div class="pub-stats">
                        <span class="likes-count">❤️ @cantidadLikes Me Gusta@(cantidadLikes != 1 ? "s" : "")</span>
                        <span class="comments-count">💬 @comentarios.Count Comentario@(comentarios.Count != 1 ? "s" : "")</span>
                    </div>

                    <!-- Acciones -->
                    <div class="pub-actions">
                        <form action="@Url.Action("AgregarLike", "Home")" method="post" style="display: inline; width: 50%;">
                            <input type="hidden" name="idPublicacion" value="@pub.Id" />
                            <button type="submit" class="action-button @(yaLike ? "liked" : "")">
                                @(yaLike ? "❤️ Me Encanta" : "🤍 Me Gusta")
                            </button>
                        </form>
                        <button class="action-button" onclick="toggleComments(@pub.Id)" style="width: 50%;">💬 Comentar</button>
                    </div>

                    <!-- Comentarios -->
                    <div class="comments-section" id="comments-@pub.Id" style="display: none;">
                        @if (comentarios.Count > 0)
                        {
                            <div class="comments-list">
                                @foreach (var com in comentarios)
                                {
                                    var usuarioComentario = BD.ObtenerUsuarioPorId(com.IdUsuarioComenta);
                                    <div class="comment">
                                        <div class="comment-header">
                                            <strong>@usuarioComentario.nombre @usuarioComentario.apellido</strong>
                                            <small>@@@ @usuarioComentario.nombreUsuario</small>
                                        </div>
                                        <p class="comment-text">@com.Texto</p>
                                        <small class="comment-date">@DateTime.Parse(com.FechaComentario).ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Formulario de Comentario -->
                        <form action="@Url.Action("AgregarComentario", "Home")" method="post" class="comment-form">
                            <input type="hidden" name="idPublicacion" value="@pub.Id" />
                            <div class="comment-input-wrapper">
                                <input type="text" 
                                       name="texto" 
                                       placeholder="Escribe un comentario..." 
                                       class="comment-input" 
                                       required />
                                <button type="submit" class="comment-submit">➤</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

<script>
    function toggleComments(publicacionId) {
        const commentsSection = document.getElementById('comments-' + publicacionId);
        if (commentsSection.style.display === 'none') {
            commentsSection.style.display = 'block';
        } else {
            commentsSection.style.display = 'none';
        }
    }
</script>

<style>
